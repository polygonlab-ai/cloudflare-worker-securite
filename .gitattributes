# Normalised line endings (LF) for every text file.
* text=auto eol=lf

# Development files excluded from source archives (git archive).
/.github export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.prettierignore export-ignore
/.prettierrc.json export-ignore
/eslint.config.js export-ignore
/vitest.config.ts export-ignore
/CHANGELOG.md export-ignore

# Repository sheet read by the publishing tool: never published.
/depot.json export-ignore
